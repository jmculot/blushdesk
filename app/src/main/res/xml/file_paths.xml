<?xml version="1.0" encoding="utf-8"?>
<!--
    The only folders FileProvider may share. Each entry is a sub-folder of the app's private cache,
    never the cache root, so a content:// URI can only ever point at a generated document.
    The folder names must match AppFiles.RECEIPTS_DIR / EXPORTS_DIR / CAMERA_DIR.
-->
<paths>
    <!-- PDF receipts, shared and opened from the "Receipt ready" dialog. -->
    <cache-path name="receipts" path="receipts/" />
    <!-- Excel exports, handed to the system share sheet. -->
    <cache-path name="exports" path="exports/" />
    <!-- Where the camera app writes a photo before the app copies it into private storage. -->
    <cache-path name="camera" path="camera/" />
</paths>
